{
	"manifest_version": 2,
	"name": "Snappy Selection Search",
	"version": "3.48.0",

	"description": "Swiftly access your search engines in a popup panel when you select text in a webpage. Context search menu also included!",
	"homepage_url": "https://github.com/haukist/snappy-selection-search",

	"icons": {
		"48": "icons/icon48.png",
		"96": "icons/icon96.png"
	},

	"background": {
		"page": "swift-selection-search.html"
	},

	"applications": {
		"gecko": {
			"id": "snappy-selection-search@haukist",
			"strict_min_version": "128.0"
		}
	},

	"options_ui": {
		"browser_style": true,
		"page": "settings/settings.html",
		"open_in_tab": true
	},

	"permissions": ["<all_urls>", "clipboardWrite", "contextMenus", "search", "storage", "webNavigation"],
	"optional_permissions": ["downloads", "tabs"],

	"commands": {
		"open-popup": {
			"suggested_key": { "default": "Ctrl+Shift+Space" },
			"description": "Open the popup (if text is selected)"
		},
		"toggle-auto-popup": {
			"suggested_key": { "default": "Ctrl+Shift+U" },
			"description": "Switch popup opening behaviour between \"Auto\" and \"Keyboard-only\""
		}
	},

	"web_accessible_resources": ["res/*", "content-scripts/popup.css"]
}
