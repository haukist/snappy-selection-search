{
  "name": "snappy-selection-search",
  "version": "1.0.0",
  "private": true,
  "description": "Snappy Selection Search (SSS) is a simple Firefox and Chrome extension that lets you quickly search for some text in a page using your favorite search engines.",
  "main": "swift-selection-search.js",
  "homepage": "https://github.com/haukist/snappy-selection-search",
  "scripts": {
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "package:chrome": "node scripts/build.mjs chrome --zip",
    "test": "node --test tests/*.test.mjs",
    "test:chrome": "node tests/chrome-integration.mjs"
  },
  "author": "haukist",
  "contributors": ["Daniel Lobo (original Swift Selection Search)"],
  "license": "MIT",
  "dependencies": {
    "@types/firefox-webext-browser": "^82.0.0",
    "typescript": "^4.1.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@kyralabs/m3e-css": "^1.8.0",
    "@kyralabs/m3e-tokens": "^1.8.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright": "^1.65.0"
  }
}
